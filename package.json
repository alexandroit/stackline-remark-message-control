{
  "xo": {
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-remark-message-control/issues"
  },
  "main": "index.js",
  "name": "@stackline/remark-message-control",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --conditions development test.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://alexandro.net/docs/vanilla/remark-message-control/",
  "keywords": [
    "stackline",
    "npm-package",
    "remark-message-control",
    "typescript",
    "unified",
    "remark",
    "remark-plugin",
    "plugin",
    "mdast",
    "markdown",
    "comment",
    "message",
    "marker",
    "control",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-remark-message-control.git"
  },
  "description": "remark plugin to enable, disable, and ignore messages with remark",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    },
    {
      "name": "Christian Murphy",
      "email": "christian.murphy.42@gmail.com"
    }
  ],
  "dependencies": {
    "vfile": "^5.0.0",
    "unified": "^10.0.0",
    "@types/mdast": "^3.0.0",
    "mdast-comment-marker": "^2.0.0",
    "unified-message-control": "^4.0.0"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm"
    ]
  },
  "typeCoverage": {
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true
  },
  "devDependencies": {
    "remark": "^14.0.0",
    "remark-toc": "^8.0.0",
    "tape": "5.10.2",
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "license",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "overrides": {
    "tape": {
      "glob": "^13.0.6"
    }
  }
}
